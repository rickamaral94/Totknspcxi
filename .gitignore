# your own game files and what's made from them (building from source puts them here)
input/
/ROM/
# the BOTW dump (exefs/ + romfs/ under Dump/<title id>/): never committed
/Dump/
/drivers/
extracted/
generated/
generated-*/
/rando/
# Nintendo fonts (users import their own; only the README ships)
/fonts/*
!/fonts/README.md
# build output, caches, saves and settings
build/
/cache/
save/
/larecomp.ini
# tools and Python environments (machine-specific)
tools/venv/
venv/
__pycache__/
.DS_Store

# test captures (screenshots, videos from testers)
testes/
# NSP/XCI import (tools/nximport): the player's own keys and packages are never committed
*.keys
*.nsp
*.xci
*.nsz
*.xcz
*.nca
*.ncz
*.tik

# Lossless Scaling: the user's own DLL and the shaders translated from it never go into the repository
Lossless.dll
*.spv
