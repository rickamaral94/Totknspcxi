<?xml version="1.0" encoding="utf-8"?>
<!-- The player's keys (Import from NSP/XCI: <data>/no_backup/keys) never go to a cloud backup or a device-to-device
     transfer. (allowBackup="false" covers only cloud backups before Android 12; everything else is as it was.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>
